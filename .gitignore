!evaluation/datasets/**/*.pdf

# ---------- Model artifacts & caches ----------
.cache/
hf_cache/
*.safetensors
*.bin
*.onnx

# ---------- Evaluation run output (keep the folder, not generated runs) ----------
evaluation/reports/*
!evaluation/reports/.gitkeep
!evaluation/reports/README.md

# ---------- Logs & test artifacts ----------
logs/
*.log
test-results/
playwright-report/

