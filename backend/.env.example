# PaperTrail AI backend configuration. Copy to backend/.env and fill in values.
# Never commit backend/.env. Only placeholder values belong in this file.

# development | test | production   (production refuses local auth/sqlite/local storage)
APP_ENV=development
LOG_LEVEL=INFO

# ---- Authentication -------------------------------------------------------------------
# local    = single-user development mode, NO authentication (refused in production)
# supabase = verify Supabase Auth access tokens via the Supabase Auth API
AUTH_MODE=local

# ---- Database & file storage -----------------------------------------------------------
# sqlite   = local file database for development (data/papertrail.db)
# postgres = Supabase PostgreSQL with pgvector (apply database/migrations first)
DATABASE_BACKEND=sqlite
# Supabase: Project Settings -> Database -> Connection string (URI). Use the session or
# transaction pooler string; the backend disables prepared statements for the pooler.
DATABASE_URL=

# local    = files under data/uploads (development)
# supabase = private Supabase Storage bucket "documents"
STORAGE_BACKEND=local

SUPABASE_URL=
# Public anon key: used server-side only to verify user access tokens with Supabase Auth.
SUPABASE_ANON_KEY=
# Service-role key: server-side only, used for private Storage. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ---- Gemini (claim assessment) ---------------------------------------------------------
# Leave both empty to run without assessment: retrieval still works and passages are
# shown as "unassessed"; no verdict is produced.
GOOGLE_API_KEY=
# Use a current model ID available to your key (check https://ai.google.dev/gemini-api/docs/models).
# The Settings page has a "Check model access" button that verifies this value.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# ---- Embeddings ------------------------------------------------------------------------
# sentence-transformers (real, local model) | hashing (test-only, not semantic; refused in production)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model AND the vector(…) column in database/migrations/0001_initial_schema.sql
EMBEDDING_DIMENSION=384

# ---- Ingestion limits ------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=300
CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=50

# ---- Retrieval -------------------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SEMANTIC_SIMILARITY=0.60

# ---- HTTP ------------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_VERIFY_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
