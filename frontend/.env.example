# PaperTrail AI frontend configuration. Copy to frontend/.env.local and fill in values.
# Never commit .env.local. NEXT_PUBLIC_* values are embedded in browser code.

# Supabase Auth (public values; protected by Row Level Security). Leave both empty to run
# in explicit local development mode without authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: where the Next.js route handler forwards /api/backend/* requests.
# Not exposed to the browser. Defaults to http://127.0.0.1:8000.
API_BASE_URL=http://127.0.0.1:8000

# NEVER put GOOGLE_API_KEY or SUPABASE_SERVICE_ROLE_KEY in this file.
